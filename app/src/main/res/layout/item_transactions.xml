<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center"
    android:layout_marginTop="8dp"
    android:orientation="vertical">

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_marginBottom="@dimen/_5sdp"
        android:layout_marginHorizontal="@dimen/_4sdp"
        android:layout_height="@dimen/_60sdp"
        app:cardCornerRadius="@dimen/_5sdp"
        android:background="@color/appGray"
        app:cardElevation="@dimen/_10sdp">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="center"
            android:gravity="center"
            android:orientation="horizontal">
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:gravity="center|start"
                android:paddingLeft="@dimen/_16sdp"
                android:layout_weight="0.8"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/ietm_payment_booking_id"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Booking ID : 12301230"
                    android:textSize="@dimen/_10sdp"
                    style="@style/GlobalTextViewStyle" />

                <TextView
                    android:id="@+id/ietm_payment_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="24 June | 9:30 AM"
                    android:textSize="@dimen/_10sdp"
                    android:textColor="@color/appTextGray"
                    style="@style/GlobalTextViewStyle" />
            </LinearLayout>
            <LinearLayout
                android:layout_width="0dp"
                android:layout_marginRight="@dimen/_16sdp"
                android:layout_height="@dimen/_32sdp"
                android:background="@drawable/ic_payments_green_bg"
                android:layout_weight="0.3">

                <TextView
                    android:id="@+id/ietm_payment_amount"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/_25sdp"
                    android:paddingStart="@dimen/_10sdp"
                    android:paddingEnd="@dimen/_10sdp"
                    android:paddingTop="3dp"
                    style="@style/GlobalTextViewStyle"
                    android:text="₹ 150 "
                    android:textSize="@dimen/_11sdp"
                    android:layout_gravity="center"
                    android:gravity="center"
                    android:textColor="@color/white" />
            </LinearLayout>


        </LinearLayout>
    </androidx.cardview.widget.CardView>

</LinearLayout>