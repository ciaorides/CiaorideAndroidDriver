<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:tools="http://schemas.android.com/tools"
    android:background="@color/grayLight"
    android:orientation="vertical">

    <TextView
        style="@style/GlobalTextViewBoldStyle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/_3sdp"
        android:layout_marginTop="@dimen/_10sdp"
        android:text="@string/id_verification"
        android:textSize="@dimen/_12ssp" />

    <TextView
        style="@style/GlobalTextViewStyle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/_3sdp"
        android:layout_marginTop="@dimen/_8sdp"
        android:text="@string/driving_licence" />

    <LinearLayout
        android:id="@+id/ll_dl"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginTop="@dimen/_5sdp"
        android:background="@drawable/rounded_edittext_white"
        android:gravity="center"
        android:orientation="horizontal"
        android:padding="@dimen/_5sdp"
        android:weightSum="2">

        <TextView
            android:id="@+id/txt_dl_Name"
            android:layout_width="0dp"
            android:singleLine="true"
            android:fontFamily="@font/inter_regular"
            android:layout_height="wrap_content"
            android:layout_weight="1.3" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnUploadDL"
            style="@style/GlobalTextViewStyle"
            android:layout_width="0dp"
            android:layout_height="@dimen/_24sdp"
            android:layout_gravity="center"
            android:layout_margin="@dimen/_2sdp"
            android:layout_weight="0.7"
            android:background="@drawable/blue_button_bgr"
            android:padding="@dimen/_3sdp"
            android:text="@string/upload_image"
            android:textAllCaps="false"
            android:textColor="@color/white" />
    </LinearLayout>
    <LinearLayout
        android:id="@+id/llDrivingLicence"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_margin="@dimen/_3sdp"
        android:gravity="center"
        android:visibility="gone"
        android:orientation="horizontal"
        android:padding="@dimen/_5sdp"
        >
        <ImageView
            android:id="@+id/dlFront"
            android:layout_width="@dimen/_60sdp"
            android:layout_height="@dimen/_60sdp"
            android:layout_marginEnd="@dimen/_30sdp"
            tools:src="@drawable/ic_user"/>
        <ImageView
            android:id="@+id/dlBack"
            android:layout_width="@dimen/_60sdp"
            android:layout_height="@dimen/_60sdp"
            tools:src="@drawable/ic_user"/>
    </LinearLayout>
    <TextView
        style="@style/GlobalTextViewStyle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/_2sdp"
        android:layout_marginTop="@dimen/_8sdp"
        android:text="@string/pan_card" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_margin="@dimen/_3sdp"
        android:background="@drawable/rounded_edittext_white"
        android:gravity="center"
        android:orientation="horizontal"
        android:padding="@dimen/_5sdp"
        android:weightSum="2">

        <TextView
            android:id="@+id/txt_PAN_Name"
            android:layout_width="0dp"
            android:singleLine="true"
            android:layout_height="wrap_content"
            android:fontFamily="@font/inter_regular"
            android:layout_marginStart="@dimen/_2sdp"
            android:layout_weight="1.3" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnUploadPAN"
            style="@style/GlobalTextViewStyle"
            android:layout_width="0dp"
            android:layout_height="@dimen/_24sdp"
            android:layout_gravity="center"
            android:layout_margin="@dimen/_2sdp"
            android:layout_weight="0.7"
            android:background="@drawable/blue_button_bgr"
            android:padding="@dimen/_3sdp"
            android:text="@string/upload_image"
            android:textAllCaps="false"
            android:textColor="@color/white" />
    </LinearLayout>
    <LinearLayout
        android:id="@+id/llPanCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_margin="@dimen/_3sdp"
        android:gravity="center"
        android:visibility="gone"
        android:orientation="horizontal"
        android:padding="@dimen/_5sdp"
        >
        <ImageView
            android:id="@+id/ivPanFront"
            android:layout_width="@dimen/_60sdp"
            android:layout_height="@dimen/_60sdp"
            android:layout_marginEnd="@dimen/_30sdp"
            tools:src="@drawable/ic_user"/>
        <ImageView
            android:id="@+id/ivPanBack"
            android:layout_width="@dimen/_60sdp"
            android:layout_height="@dimen/_60sdp"
            tools:src="@drawable/ic_user"/>
    </LinearLayout>
    <TextView
        style="@style/GlobalTextViewStyle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/_2sdp"
        android:layout_marginTop="@dimen/_8sdp"
        android:text="@string/adhar_card" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_margin="@dimen/_3sdp"
        android:background="@drawable/rounded_edittext_white"
        android:gravity="center"
        android:orientation="horizontal"
        android:padding="@dimen/_5sdp"
        android:weightSum="2">

        <TextView
            android:id="@+id/txt_Adhar_Name"
            android:fontFamily="@font/inter_regular"
            android:layout_width="0dp"
            android:singleLine="true"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/_2sdp"
            android:layout_weight="1.3" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnUploadAdhar"
            style="@style/GlobalTextViewStyle"
            android:layout_width="0dp"
            android:layout_height="@dimen/_24sdp"
            android:layout_gravity="center"
            android:layout_margin="@dimen/_2sdp"
            android:layout_weight="0.7"
            android:background="@drawable/blue_button_bgr"
            android:padding="@dimen/_3sdp"
            android:text="@string/upload_image"
            android:textAllCaps="false"
            android:textColor="@color/white" />
    </LinearLayout>
    <LinearLayout
        android:id="@+id/llAadhaar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_margin="@dimen/_3sdp"
        android:gravity="center"
        android:visibility="gone"
        android:orientation="horizontal"
        android:padding="@dimen/_5sdp"
        >
        <ImageView
            android:id="@+id/ivAadhaarFront"
            android:layout_width="@dimen/_60sdp"
            android:layout_height="@dimen/_60sdp"
            android:layout_marginEnd="@dimen/_30sdp"
            tools:src="@drawable/ic_user"/>
        <ImageView
            android:id="@+id/ivAadhaarBack"
            android:layout_width="@dimen/_60sdp"
            android:layout_height="@dimen/_60sdp"
            tools:src="@drawable/ic_user"/>
    </LinearLayout>
</LinearLayout>